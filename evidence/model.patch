+++        snapshot_id = staging.snapshot_id
+++        snapshot_dir = self.snapshot_dir(snapshot_id)
+++        snapshot_dir.mkdir(parents=True, exist_ok=True)
+++
+++        current_names = {(item.type, item.name) for item in staging.items.values()}
