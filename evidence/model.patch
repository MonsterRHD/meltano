+++++            try:
+++++                if path.is_dir() and not path.is_symlink():
+++++                    shutil.rmtree(path)
+++++                else:
+++++                    path.unlink()
+++++            except OSError as err:
+++++                self.remove_status = PluginLocationRemoveStatus.ERROR
+++++                self.message = err.strerror
