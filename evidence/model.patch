++++        variant_obj = definition.find_variant(item.variant)
++++        content = (
++++            json.dumps(
++++                StandalonePlugin.from_variant(
++++                    variant_obj,
++++                    definition,
++++                ).canonical(),
++++                indent=2,
++++            )
++++            + "\n"
