++def write_custom_plugin(project: Project, pip_url: str) -> ProjectPlugin:
++    payload = {
++        "plugins": {
++            "extractors": [
++                {
++                    "name": "tap-custom",
++                    "namespace": "tap_custom",
++                    "pip_url": pip_url,
++                    "executable": EXECUTABLE_NAME,
++                },
++            ],
++        },
