+++
+++        current = self.read_manifest()
+++        self._prune_snapshots(
+++            keep=current.snapshot_id if current else None,
+++        )
+++
+++    @staticmethod
+++    def _now() -> str:
+++        return datetime.now(tz=timezone.utc).isoformat()
