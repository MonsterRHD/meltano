+++    # --- Cleanup ---
+++
+++    def _discard_staging(self, snapshot_id: str) -> None:
+++        path = self.staging_dir(snapshot_id)
+++        if path.exists():
+++            shutil.rmtree(path)
+++
+++    def _prune_snapshots(self, *, keep: str | None) -> None:
+++        root = self.project.dirs.plugin_lock_snapshots_dir()
+++        if not root.exists():
