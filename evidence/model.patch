+++    def test_retry_reuses_success_and_reruns_failed(
+++        self,
+++        subject: LockSnapshotService,
+++        tap: ProjectPlugin,
+++        hub_request_counter,
+++    ) -> None:
+++        # First batch: tap succeeds, bad plugin fails.
