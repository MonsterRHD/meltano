+
+        hub_request_counter.clear()
+        second = subject.begin_batch(subject.read_manifest())
+        subject.add_item(second, tap)
+        results = subject.prepare(second)
+
+        result = results[0]
+        # Not reused: fingerprints embed the origin, and the other origin has
