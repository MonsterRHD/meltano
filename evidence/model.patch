+            "plugin_name": self.plugin_name,
+            "phase": self.phase,
+            "fingerprint": self.fingerprint,
+            "steps_completed": self.steps_completed,
+            "moved": self.moved,
+            "cleanup_pending": self.cleanup_pending,
