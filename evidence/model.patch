+        service.venv.write_fingerprint(plan.pip_install_args)
+
+        deps_marker = paths.marker(plan.plan_id, DEPS_INSTALLED)
+        deps_marker.parent.mkdir(parents=True, exist_ok=True)
+        deps_marker.touch()
