+        subject.prepare(first)
+
+        # Point the project at a different Hub origin.
+        monkeypatch.setattr(
+            MeltanoHubService,
+            "hub_api_url",
+            property(
+                lambda _self: "https://other-hub.example.com/meltano/api/v1",
+            ),
