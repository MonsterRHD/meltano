+++    def _entry_from_item(
+++        self,
+++        snapshot_id: str,
+++        item: StagingItem,
+++    ) -> SnapshotEntry:
+++        """Build a snapshot entry from a staging item and copy its file."""
+++        if item.kind == ENTRY_LOCKED:
+++            variant = item.resolved_variant or item.variant
