+++                    SnapshotEntry(
+++                        type=plugin_type.value,
+++                        name=name,
+++                        kind=ENTRY_LEGACY,
+++                        variant=variant,
+++                        file=rel,
+++                        provenance=provenance,
+++                        is_default_variant=variant is None,
+++                    ),
