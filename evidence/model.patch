++++            return SnapshotEntry(
++++                type=item.type,
++++                name=item.name,
++++                kind=ENTRY_LOCKED,
++++                variant=variant,
++++                file=rel,
++++                provenance=item.provenance,
++++                is_default_variant=item.is_default_variant,
