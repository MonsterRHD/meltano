++++        self,
++++        *,
++++        plugin_type: str,
++++        plugin_name: str,
++++        variant_name: str | None,
++++    ) -> SnapshotEntry | None:
++++        """Find the entry for a plugin and variant, if one is listed.
++++
++++        Args:
